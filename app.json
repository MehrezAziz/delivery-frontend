{
  "expo": {
    "name": "Local Delivery",
    "slug": "delivery-frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "deliveryapp",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "plugins": [
      "./plugins/withAndroidUserDebugKeystore.js",
      "./plugins/withAndroidNotifeeForegroundService.js",
      "@react-native-google-signin/google-signin",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#0284c7"
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "Camera access is required for identity verification and liveness.",
          "enableMicrophonePermission": false,
          "enableFrameProcessors": false
        }
      ],
      "expo-audio",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow $(PRODUCT_NAME) to confirm your identity before editing your profile."
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.delivery.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Camera access is required for identity verification and liveness."
      }
    },
    "android": {
      "versionCode": 7,
      "softwareKeyboardLayoutMode": "resize",
      "blockedPermissions": ["com.google.android.gms.permission.AD_ID"],
      "permissions": [
        "POST_NOTIFICATIONS",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.localsmartdelivery.app",
      "googleServicesFile": "./google-services.json",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyCxI8rf9D9Idd-gGL6GEED0WFLnWHyN8To"
        }
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "d90667e9-926a-4112-91f5-fe6ada8c0716"
      }
    },
    "owner": "azizmehrez"
  }
}
