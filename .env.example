# Copy to `.env` (gitignored). Metro loads this for LOCAL development only.
#
# Play Store builds ignore this file and use `eas.json` → production.env instead.
#
# API — include /api if your server uses that prefix
# USB + local backend: adb reverse tcp:3000 tcp:3000 then:
EXPO_PUBLIC_API_URL=http://127.0.0.1:3000/api
# Emulator: http://10.0.2.2:3000/api
# Same Wi‑Fi: http://YOUR_PC_LAN_IP:3000/api
# Production: https://your-api.example.com/api

# Google Maps / Places (restrict key to Maps SDK + Places/Geocode as needed)
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Google Sign-In — OAuth 2.0 "Web application" client ID (same project as Firebase).
# Leave unset to use the built-in production ID (also set in eas.json for store builds).
# For LOCAL/dev Firebase app only: set here — file is gitignored, never commit.
# Your backend GOOGLE_CLIENT_ID must match this value while testing Google login locally.
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
