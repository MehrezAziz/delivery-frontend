# - Physical device, USB + `adb reverse tcp:3000 tcp:3000`:  http://127.0.0.1:3000/api
# - Same Wi‑Fi as PC:  http://YOUR_PC_LAN_IP:3000/api
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000/api

